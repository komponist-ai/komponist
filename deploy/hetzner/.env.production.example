# Public HTTPS origins. Assign these domains to the matching services in Coolify.
PUBLIC_WEB_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_MCP_URL=https://mcp.example.com

# Generate URL-safe values with:
#   openssl rand -hex 32
# Keep KOMPONIST_SECRET_KEY stable or stored connector tokens become unreadable.
POSTGRES_PASSWORD=replace-with-hex-secret
KOMPONIST_NEO4J_PASSWORD=replace-with-hex-secret
KOMPONIST_SECRET_KEY=replace-with-64-character-hex-secret

# Defaults for an 8 GB server. For a temporary 4 GB CPX22 use 128m/512m/256m.
# These deployment inputs deliberately do not start with NEO4J_. Coolify passes
# resource variables into containers, and Neo4j interprets every NEO4J_* value
# as a database configuration setting.
KOMPONIST_NEO4J_HEAP_INITIAL_SIZE=256m
KOMPONIST_NEO4J_HEAP_MAX_SIZE=1g
KOMPONIST_NEO4J_PAGECACHE_SIZE=512m

# Centrally managed AI runtime. Workspace members never provide their own key.
KOMPONIST_AI_MODE=live
KOMPONIST_LLM_PROVIDER=openai
KOMPONIST_LLM_MODEL=gpt-5.6-terra
KOMPONIST_OPENAI_STORE=false
KOMPONIST_EMBEDDING_PROVIDER=openai
KOMPONIST_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google account login.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Connected sources. Redirect URIs are derived from PUBLIC_API_URL by Compose.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEBHOOK_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_WATCHED_CHANNELS=
SLACK_APPROVALS_CHANNEL=

# Optional ingestion integrations.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
