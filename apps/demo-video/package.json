{
  "name": "komponist-demo-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repeatable YC product demo capture and branded video render",
  "scripts": {
    "capture": "node --import tsx capture.ts",
    "voiceover:elevenlabs": "node --import tsx generate-voiceover.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts KomponistYC out/komponist-yc-demo.mp4",
    "render:voice": "remotion render src/index.ts KomponistYC out/komponist-yc-demo.mp4 --props=voiceover-props.json",
    "render:elevenlabs": "remotion render src/index.ts KomponistYC out/komponist-yc-demo.mp4 --props=voiceover-props.generated.json",
    "render:recordly": "remotion render src/index.ts KomponistRecordly out/komponist-yc-demo-recordly.mp4 --props=voiceover-props.generated.json --codec=h264 --crf=10 --image-format=png --pixel-format=yuv420p --x264-preset=slow",
    "render:recordly:silent": "remotion render src/index.ts KomponistRecordly out/komponist-yc-demo-recordly.mp4 --codec=h264 --crf=10 --image-format=png --pixel-format=yuv420p --x264-preset=slow",
    "render:recordly:4k": "remotion render src/index.ts KomponistRecordly out/komponist-yc-demo-recordly-4k.mp4 --props=voiceover-props.generated.json --scale=2 --codec=h264 --crf=10 --image-format=png --pixel-format=yuv420p --x264-preset=slow",
    "demo": "npm run capture && npm run render",
    "demo:elevenlabs": "npm run capture && npm run voiceover:elevenlabs && npm run render:elevenlabs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "playwright": "^1.54.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
