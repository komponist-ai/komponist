# ============================================================================
# Komponist Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# AI Runtime
# ============================================================================
# mock: no API key, no network, deterministic test doubles (not real AI)
# live: call the configured OpenAI models
KOMPONIST_AI_MODE=live

# OpenAI Responses API
KOMPONIST_LLM_PROVIDER=openai
KOMPONIST_LLM_MODEL=gpt-5.6-terra

# Do not retain Responses API application state by default
KOMPONIST_OPENAI_STORE=false

# ============================================================================
# Embedding Provider
# ============================================================================
KOMPONIST_EMBEDDING_PROVIDER=openai

# Embedding model
# 1536 dimensions, matching the Neo4j vector index
KOMPONIST_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# API Keys
# ============================================================================
# Leave empty in mock mode. Set only in your local .env when switching to live.
OPENAI_API_KEY=

# Webhook signatures (leave unsigned webhooks disabled outside isolated tests)
GITHUB_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_WEBHOOK_TOKEN=
KOMPONIST_ALLOW_UNSIGNED_WEBHOOKS=false

# ============================================================================
# Local Documents
# ============================================================================
# Path to scan for markdown, text, and YAML files
KOMPONIST_LOCAL_DOCS_PATH=./docs

# Host path mounted by docker/docker-compose.yml (relative to the docker directory)
KOMPONIST_LOCAL_DOCS_HOST_PATH=../docs

# File extensions to include (comma-separated)
KOMPONIST_LOCAL_DOCS_EXTENSIONS=.md,.txt,.yaml,.yml

# ============================================================================
# Database - Neo4j
# ============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword

# ============================================================================
# Database - Postgres
# ============================================================================
DATABASE_URL=postgresql+asyncpg://komponist:devpassword@localhost:5432/komponist

# Encrypts connector credentials stored in Postgres. Use a long random value
# and keep it stable; changing it makes existing connector configs unreadable.
KOMPONIST_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/auth/login/google/callback
FRONTEND_URL=http://localhost:3000
KOMPONIST_COOKIE_SECURE=false

# For Docker Compose (internal network)
# DATABASE_URL=postgresql+asyncpg://komponist:devpassword@postgres:5432/komponist

# ============================================================================
# Notion Connector
# ============================================================================
# Create an integration at https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/auth/notion/callback

# ============================================================================
# Slack Connector
# ============================================================================
# Create an app at https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ============================================================================
# Google Workspace Connector
# ============================================================================
# Create OAuth credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ============================================================================
# API Server
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# Web App
# ============================================================================
# API URL for the frontend to call
API_URL=http://localhost:8000

# ============================================================================
# MCP Server
# ============================================================================
MCP_HOST=0.0.0.0
MCP_PORT=8080
