# Komponist API Dockerfile
# FastAPI backend for webhooks, REST endpoints, and OAuth

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package definitions first for better caching
COPY packages/core/pyproject.toml packages/core/
COPY packages/pipelines/pyproject.toml packages/pipelines/

# Copy package source code
COPY packages/core/ packages/core/
COPY packages/pipelines/ packages/pipelines/

# Install packages in editable mode
RUN pip install --no-cache-dir -e packages/core
RUN pip install --no-cache-dir -e packages/pipelines

# Copy API requirements and install
COPY apps/api/requirements.txt apps/api/
RUN pip install --no-cache-dir -r apps/api/requirements.txt

# Copy API source code
COPY apps/api/ apps/api/

# Set working directory to API
WORKDIR /app/apps/api

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/healthz || exit 1

# Run the API
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
