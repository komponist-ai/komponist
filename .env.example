# ============================================================================
# Komponist Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Provider
# ============================================================================
# Options: anthropic, openai, ollama
KOMPONIST_LLM_PROVIDER=ollama

# Model to use (depends on provider)
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-8, claude-haiku-4-5-20251001
# OpenAI: set this to a currently supported OpenAI model
# Ollama: qwen3.5:9b (recommended for 16 GB Macs), qwen3.5:4b
KOMPONIST_LLM_MODEL=qwen3.5:9b

# ============================================================================
# Embedding Provider
# ============================================================================
# Options: openai, ollama
KOMPONIST_EMBEDDING_PROVIDER=ollama

# Embedding model
# OpenAI: text-embedding-3-small, text-embedding-3-large
# Ollama: qwen3-embedding:0.6b (native 1024 dimensions)
KOMPONIST_EMBEDDING_MODEL=qwen3-embedding:0.6b

# ============================================================================
# API Keys
# ============================================================================
# Anthropic (required if using anthropic provider)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (required if using openai for LLM or embeddings)
OPENAI_API_KEY=sk-...

# ============================================================================
# Ollama (for local models)
# ============================================================================
# URL of your Ollama instance
# Docker services reach the Ollama macOS app through this hostname.
# Use http://localhost:11434 when running the Python services directly on macOS.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ============================================================================
# Local Documents
# ============================================================================
# Path to scan for markdown, text, and YAML files
KOMPONIST_LOCAL_DOCS_PATH=./docs

# Host path mounted by docker/docker-compose.yml (relative to the docker directory)
KOMPONIST_LOCAL_DOCS_HOST_PATH=../docs

# File extensions to include (comma-separated)
KOMPONIST_LOCAL_DOCS_EXTENSIONS=.md,.txt,.yaml,.yml

# ============================================================================
# Database - Neo4j
# ============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword

# ============================================================================
# Database - Postgres
# ============================================================================
DATABASE_URL=postgresql+asyncpg://komponist:devpassword@localhost:5432/komponist

# For Docker Compose (internal network)
# DATABASE_URL=postgresql+asyncpg://komponist:devpassword@postgres:5432/komponist

# ============================================================================
# Notion Connector
# ============================================================================
# Create an integration at https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/auth/notion/callback

# ============================================================================
# Slack Connector
# ============================================================================
# Create an app at https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ============================================================================
# Google Workspace Connector
# ============================================================================
# Create OAuth credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ============================================================================
# API Server
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# Web App
# ============================================================================
# API URL for the frontend to call
API_URL=http://localhost:8000

# ============================================================================
# MCP Server
# ============================================================================
MCP_HOST=0.0.0.0
MCP_PORT=8080
