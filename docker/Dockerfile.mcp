# Komponist MCP Server Dockerfile
# FastMCP server exposing tools to AI agents

FROM python:3.14-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package definitions first for better caching
COPY packages/core/pyproject.toml packages/core/
COPY packages/pipelines/pyproject.toml packages/pipelines/

# Copy package source code
COPY packages/core/ packages/core/
COPY packages/pipelines/ packages/pipelines/

# Install packages in editable mode
RUN pip install --no-cache-dir -e packages/core
RUN pip install --no-cache-dir -e packages/pipelines

# Copy MCP requirements and install
COPY apps/mcp/requirements.txt apps/mcp/
RUN pip install --no-cache-dir -r apps/mcp/requirements.txt

# Copy MCP source code
COPY apps/mcp/ apps/mcp/
COPY apps/api/database.py apps/api/database.py

# Run application code without root privileges in production.
RUN useradd --create-home --uid 10001 komponist

# Set working directory to MCP
WORKDIR /app/apps/mcp

USER komponist

# Expose port
EXPOSE 8080

# Run the MCP server
# Note: fastmcp uses stdio by default, but we expose HTTP for Docker networking
CMD ["fastmcp", "run", "server.py:mcp", "--transport", "http", "--host", "0.0.0.0", "--port", "8080"]
